# syntax=docker/dockerfile:1
# EvalForge agent sandbox image — isolated workspace for DockerSandbox runs.
#
# Used by workers via WORKER_SANDBOX_IMAGE (default: evalforge/sandbox:local).
# Deterministic / FakeDocker tests do not require this image.
#
# Live Claude Code CLI (optional): install after build or extend this Dockerfile.
# Credentials must be injected explicitly at runtime — never bake secrets in.

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        python3 \
        coreutils \
        findutils \
        grep \
        sed \
        tar \
        gzip \
    && rm -rf /var/lib/apt/lists/*

# Optional agent CLIs — installed only when build args are set (requires network).
# Default image stays lean for deterministic-only runs.
# Gemini CLI requires Node >= 20; Debian bookworm ships Node 18, so use NodeSource.
ARG EVALFORGE_INSTALL_CLAUDE_CLI=0
ARG EVALFORGE_INSTALL_GEMINI_CLI=0
RUN if [ "$EVALFORGE_INSTALL_CLAUDE_CLI" = "1" ] || [ "$EVALFORGE_INSTALL_GEMINI_CLI" = "1" ]; then \
      apt-get update \
      && apt-get install -y --no-install-recommends gnupg \
      && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
      && apt-get install -y --no-install-recommends nodejs \
      && rm -rf /var/lib/apt/lists/*; \
    fi
RUN if [ "$EVALFORGE_INSTALL_CLAUDE_CLI" = "1" ]; then \
      npm install -g @anthropic-ai/claude-code \
      && rm -rf /root/.npm; \
    fi
RUN if [ "$EVALFORGE_INSTALL_GEMINI_CLI" = "1" ]; then \
      npm install -g @google/gemini-cli \
      && node --version \
      && gemini --version \
      && rm -rf /root/.npm; \
    fi

# pytest for workspace test graders (objective evaluation of agent edits).
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-pytest \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /workspace \
    && chmod 777 /workspace

WORKDIR /workspace

# Keep the container alive so DockerSandbox can exec commands into it.
CMD ["sleep", "infinity"]
