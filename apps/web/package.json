    "@tanstack/react-query": "^5.67.2",
    "@tanstack/react-table": "^8.21.3",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.43.0",
    "geist": "^1.3.1",
    "next": "^15.2.1",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.84.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@agent-eval/config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
