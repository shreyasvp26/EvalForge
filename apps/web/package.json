{
  "name": "@agent-eval/web",
  "version": "0.0.0",
  "private": true,
  "description": "EvalForge web application (Next.js App Router)",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
