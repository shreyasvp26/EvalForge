{
  "name": "@agent-eval/utils",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-cutting TypeScript utilities for EvalForge",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@agent-eval/config": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
