# Application
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=info

# API (apps/api)
API_HOST=0.0.0.0
API_PORT=8000
# AUTH_DEV_ACCEPT_BEARER_AS_ACTOR_ID=true

# Web (apps/web) — placeholders for later phases
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Database — PostgreSQL (Infrastructure)
DATABASE_URL=postgresql+psycopg://localhost:5432/evalforge
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_TIMEOUT_SECONDS=30
# DATABASE_POOL_PRE_PING=true
# DATABASE_ECHO_SQL=false

# Redis — run queue / idempotency (Infrastructure)
REDIS_URL=redis://localhost:6379/0
# RUN_QUEUE_KEY_PREFIX=evalforge:runs
# RUN_QUEUE_CLAIM_TIMEOUT_SECONDS=5

# Object storage — S3-compatible (MinIO, R2, AWS, …)
# OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=evalforge-artifacts
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Auth / secrets — placeholders for later phases
# SECRET_KEY=

# Judge providers (Grader Layer — Phase 12)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_TIMEOUT_SECONDS=60
# ANTHROPIC_RETRY_COUNT=2
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
