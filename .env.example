# Application
# Keep ENVIRONMENT=development for local API + web against Postgres/Redis.
# Do not set ENVIRONMENT=test for interactive local runs — that selects MEMORY
# identity while domain APIs still use DATABASE_URL (a common empty-DB footgun).
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=info

# API (apps/api)
API_HOST=0.0.0.0
API_PORT=8000
# AUTH_DEV_ACCEPT_BEARER_AS_ACTOR_ID=true

# Docker Compose (infrastructure/docker/docker-compose.yml)
POSTGRES_DB=evalforge
POSTGRES_USER=evalforge
POSTGRES_PASSWORD=evalforge
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
WEB_PORT=3000
WORKER_ID=worker-1
# Phase 2 execution (evalforge-worker)
# Compose defaults: WORKER_SANDBOX_ENGINE=docker + socket mount + deterministic adapter.
# WORKER_ACTOR_ID=system-worker
# WORKER_SANDBOX_ENGINE=docker   # docker | fake | auto  (compose sets docker; do not silently fake)
# WORKER_ADAPTER_MODE=deterministic  # deterministic | claude
# WORKER_SANDBOX_IMAGE=evalforge/sandbox:local
# WORKER_SANDBOX_NETWORK=none  # none | bridge (bridge required for live agent CLI + git fetch)
# WORKER_SANDBOX_ENV_ALLOWLIST=ANTHROPIC_API_KEY,GEMINI_API_KEY,GOOGLE_API_KEY,PATH,HOME,TERM
# WORKER_SANDBOX_VERIFY=0  # set 1 to exec `true` after provision (extra Docker round-trip)
# WORKER_EXECUTION_TIMEOUT_SECONDS=300
# RUN_CANCEL_KEY_PREFIX=evalforge:cancel
# EVALFORGE_INSTALL_CLAUDE_CLI=0  # set 1 when building sandbox image with Claude CLI
# EVALFORGE_INSTALL_GEMINI_CLI=0  # set 1 when building sandbox image with Gemini CLI
# DOCKER_GID=0  # Linux: id -g docker; Docker Desktop usually 0
# Optional: compose --profile full|web to build/start the Next.js UI image
# EVALFORGE_LIVE_WORKER_DOCKER=0  # set 1 for workers live Docker e2e pytest
# EVALFORGE_LIVE_GEMINI_DOCKER=0  # set 1 for live Gemini Docker e2e (requires GEMINI_API_KEY)

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional About page metadata (CI can inject these)
# NEXT_PUBLIC_APP_VERSION=0.1.0
# NEXT_PUBLIC_GIT_COMMIT=abc1234
# NEXT_PUBLIC_BUILD_TIME=2026-08-02T12:00:00.000Z

# Database — PostgreSQL (Infrastructure)
# Local: postgresql+psycopg://localhost:5432/evalforge
# Compose overrides host to `postgres` inside the stack.
DATABASE_URL=postgresql+psycopg://evalforge:evalforge@localhost:5432/evalforge
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_TIMEOUT_SECONDS=30
# DATABASE_POOL_PRE_PING=true
# DATABASE_ECHO_SQL=false

# Redis — run queue / idempotency / cancel signals (Infrastructure)
# Compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
# RUN_QUEUE_KEY_PREFIX=evalforge:runs
# RUN_QUEUE_CLAIM_TIMEOUT_SECONDS=5

# Object storage — S3-compatible (MinIO, R2, AWS, …)
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=evalforge-artifacts
# OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# JWT authentication (API Layer)
# Required: at least 32 characters. Never use change-me-in-production.
# Generate one locally, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-evalforge-jwt-secret-change-me-32b
# JWT_ALGORITHM=HS256
# JWT_ISSUER=
# JWT_AUDIENCE=
# JWT_ACCESS_TOKEN_TTL_SECONDS=3600
# AUTH_DEV_ACCEPT_BEARER_AS_ACTOR_ID=false

# Bootstrap local admin (created on API startup when both are set)
AUTH_BOOTSTRAP_EMAIL=admin@evalforge.local
AUTH_BOOTSTRAP_PASSWORD=evalforge-admin
# AUTH_BOOTSTRAP_DISPLAY_NAME=EvalForge Admin

# Transport hardening / telemetry
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=120
# MAX_REQUEST_BODY_BYTES=1048576
# METRICS_ENABLED=true
# TRACING_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Claude / Anthropic credentials (NEVER commit real values)
# Used for:
#   1) Live Claude Code CLI inside the sandbox (WORKER_ADAPTER_MODE=claude)
#   2) Optional rubric judge providers (Grader Layer)
# Inject via .env / secret manager only. Workers pass ANTHROPIC_API_KEY into the
# sandbox only when listed in WORKER_SANDBOX_ENV_ALLOWLIST.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_TIMEOUT_SECONDS=60
# ANTHROPIC_RETRY_COUNT=2
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# Gemini — live Gemini CLI inside the sandbox (WORKER_ADAPTER_MODE=live + gemini adapter pin)
# Also used by optional rubric judge providers (Grader Layer).
# GEMINI_API_KEY=
# GOOGLE_API_KEY=  # alternate env name accepted by Gemini CLI
# GEMINI_MODEL=gemini-2.0-flash

# Groq — optional LLM-as-judge only (NOT the coding agent).
# Set JUDGE_PROVIDER=groq (or leave unset to auto-detect from GROQ_API_KEY).
# Default model: llama-3.3-70b-versatile (override with GROQ_MODEL).
# Local environments may also use GRAQ_API_KEY as a misspelled alias; prefer GROQ_API_KEY.
# JUDGE_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# JUDGE_PROVIDER=none  # disable judges even when API keys are present
